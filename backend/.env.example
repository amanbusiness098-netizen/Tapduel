PORT=3000
NODE_ENV=development
APP_VERSION=2.0.0
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500
VERIFY_AUTH=true

# Local: ./firebase-key.json
# Render: paste full one-line service-account JSON
FIREBASE_SERVICE_ACCOUNT_JSON=

# Admin access. Add your Firebase login email or UID.
ADMIN_EMAILS=
ADMIN_UIDS=
ALLOW_LOCAL_ADMIN=false

# Keep disabled until Razorpay account, bank/KYC, policies and testing are complete.
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
